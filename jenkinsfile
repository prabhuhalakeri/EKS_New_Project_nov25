pipeline {
    agent any

        stages {
        stage('Checkout Code') {
            steps {
                git 'https://github.com/prabhuhalakeri/EKS_New_Project_nov25.git'
            }
        }

        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }

        stage('Terraform Plan') {
            steps {
                sh 'terraform plan'
            }
        }

        stage('Terraform Apply') {
            steps {
                sh 'terraform apply -auto-approve'
            }
        }
    }
}
